{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/media/:action", "destination": "/api/storage?g=media&a=:action" },
    { "source": "/api/storage/:action", "destination": "/api/storage?g=storage&a=:action" },
    { "source": "/api/voices/:action", "destination": "/api/voices?g=voices&a=:action" },
    { "source": "/api/twitch/clip", "destination": "/api/twitch?g=twitch&a=clip" },
    { "source": "/api/twitch/subscriptions", "destination": "/api/twitch?g=twitch&a=subscriptions" },
    { "source": "/api/spotify/:action", "destination": "/api/integraciones?g=spotify&a=:action" },
    { "source": "/api/kofi/:id", "destination": "/api/integraciones?g=kofi&a=hook&id=:id" },
    { "source": "/api/riot/:action", "destination": "/api/integraciones?g=riot&a=:action" },
    { "source": "/api/integrations/:action", "destination": "/api/integraciones?g=integrations&a=:action" },
    { "source": "/api/health", "destination": "/api/version?health=1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
