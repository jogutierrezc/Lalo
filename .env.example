# Lalo Stream Suite — variables de entorno (copiar a .env y completar).
# Nunca subir el archivo .env real al repositorio.

# --- Servidor local / funciones de Vercel ---
PORT=3001

# Fish Audio API Key (obtener en https://fish.audio/)
FISH_AUDIO_API_KEY=

# Canal de Twitch por defecto (opcional)
DEFAULT_TWITCH_CHANNEL=

# --- Supabase (nube). Si se dejan vacías, la app funciona solo en local ---
# Públicas: se incluyen en el bundle del navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client ID de la aplicación de Twitch (público). El servidor también lo usa
# para buscar cortos en el saludo de raid.
VITE_TWITCH_CLIENT_ID=

# SOLO SERVIDOR (api/ y server/), sin el prefijo VITE_. Client Secret de la misma
# aplicación de Twitch (dev.twitch.tv/console/apps): con él, /api/twitch/clip busca
# el corto más visto de un canal para el saludo de raid. Si falta, el saludo sale
# sin corto. Es el mismo secreto que se pega en Supabase → Authentication →
# Providers → Twitch. En Vercel va en Settings → Environment Variables.
TWITCH_CLIENT_SECRET=

# SOLO SERVIDOR (api/ y server/). Secreto con el que Twitch firma los avisos de
# EventSub (bits, Power-ups y canjes de puntos) que envía a /api/twitch/eventsub.
# Invéntalo tú: entre 10 y 100 letras y números, sin espacios. Si falta, el canal
# de eventos queda apagado. Si lo cambias, hay que volver a encender el canal de
# eventos de cada streamer desde su página «Power-ups».
TWITCH_EVENTSUB_SECRET=

# SOLO SERVIDOR. Dirección pública (https) a la que Twitch envía los avisos, por
# ejemplo https://laloplay.vercel.app/api/twitch/eventsub. En Vercel se puede
# dejar vacía: se usa el dominio de producción del proyecto.
TWITCH_EVENTSUB_CALLBACK=

# SOLO SERVIDOR (api/ y server/). Salta todas las reglas RLS: jamás usar el
# prefijo VITE_ ni importarla desde src/.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección de Supabase para el servidor. Si se deja vacía, el servidor usa VITE_SUPABASE_URL.
SUPABASE_URL=

# --- Almacenamiento de archivos: Cloudflare R2 (guía en supabase/CLOUDFLARE-R2.md) ---
# SOLO SERVIDOR (api/ y server/), sin el prefijo VITE_. Si falta alguna, la
# consola de administración dice cuál y los streamers no pueden subir archivos.

# Identificador de la cuenta de Cloudflare (aparece en el panel de R2).
R2_ACCOUNT_ID=
# Las dos partes del token de API de R2, con permiso de lectura y escritura de objetos sobre el bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket.
R2_BUCKET=
# Dirección pública del bucket (la de r2.dev o un dominio propio), sin barra final.
R2_PUBLIC_BASE_URL=

# Pública: la misma dirección que R2_PUBLIC_BASE_URL, para que las capas de OBS
# monten la URL de cada archivo. No es un secreto.
VITE_R2_PUBLIC_BASE_URL=
